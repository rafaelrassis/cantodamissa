# ---------- Cliente (Vite) ----------
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY

# Lista de e-mails (separados por vírgula) que veem o botão "Área Admin"
# depois de logar com Google. Decide só o que aparece na tela — quem manda
# de verdade é a tabela `admins` no banco (ver README, seção Administradores)
# e as policies de RLS que consultam ela.
VITE_ADMIN_EMAILS=admin@example.com,outro@example.com

# ---------- Servidor (funções em api/) ----------
# Usadas pelos endpoints /api pra validar o token de quem chamou e conferir
# se a pessoa está na tabela `admins`. Na Vercel, basta cadastrar como
# variáveis de ambiente do projeto. Se não definir, os endpoints caem pras
# VITE_* acima.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_ANON_KEY
