# ---------- Cliente (Vite) ----------
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY

# Não existe mais lista de admins em variável de ambiente: quem é
# administrador sai da tabela `admins` no banco, que é também o que as
# policies de RLS consultam (ver README, seção Administradores).

# ---------- Servidor (funções em api/) ----------
# Usadas pelos endpoints /api pra validar o token de quem chamou e conferir
# se a pessoa está na tabela `admins`. Na Vercel, basta cadastrar como
# variáveis de ambiente do projeto. Se não definir, os endpoints caem pras
# VITE_* acima.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_ANON_KEY
