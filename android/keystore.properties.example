# Copie este arquivo para keystore.properties (mesma pasta) e preencha com
# os dados gerados por `keytool -genkeypair` (ver README.md > Android >
# assinatura do release). keystore.properties é gitignored - nunca commitar
# a keystore nem as senhas.
#
# storeFile é relativo à raiz do módulo android/.
storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
